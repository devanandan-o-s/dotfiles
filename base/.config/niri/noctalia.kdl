layout {

    focus-ring {
        active-color   "#62dbb6"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#62dbb6"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#62dbb6"
        inactive-color "#00513e"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#62dbb680"
    }
}

recent-windows {
    highlight {
        active-color "#62dbb6"
        urgent-color "#ffb4ab"
    }
}
