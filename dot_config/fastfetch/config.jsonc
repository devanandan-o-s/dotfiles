{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/fedora.txt",
    "color": {
      "1": "#63d1ef",
      "2": "#63aee9"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "#a2d1ef",
      "title": "#a8aee9"
    },
    "percent": {
      "type": 5,
      "colorGreen": "white",
      "colorYellow": "bright_white",
      "colorRed": "white",
      "color": {
        "green": "#cc8166",
        "yellow": "#92c9ec",
        "red": "#fd4663"
      }
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "command",
      "text": "─── Hardware ───"
    },
    {
      "type": "cpu",
      "key": "󰍛 CPU",
      "keyColor": "white",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "white",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "󰘚 RAM",
      "keyColor": "white"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk",
      "keyColor": "white"
    },
    "break",
    {
      "type": "command",
      "text": "─── Software ───"
    },
    {
      "type": "os",
      "key": "󰌢 OS",
      "keyColor": "white"
    },
    {
      "type": "kernel",
      "key": "󰒋 Kernel",
      "keyColor": "white"
    },
    {
      "type": "shell",
      "key": "󰆍 Shell",
      "keyColor": "white"
    },
    {
      "type": "de",
      "key": "󰖲 DE",
      "keyColor": "white"
    },
    {
      "type": "wm",
      "key": "󰖳 WM",
      "keyColor": "white"
    },
    "break",
    {
      "type": "command",
      "text": "─── Network ───"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "white"
    },
    {
      "type": "uptime",
      "key": "󰔚 Uptime",
      "keyColor": "white"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
